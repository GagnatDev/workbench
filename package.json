{
  "name": "workbench",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:homectl": "pnpm -r --parallel run dev:homectl",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "dev:frontend": "pnpm --filter @workbench/frontend run dev",
    "dev:backend": "pnpm --filter @workbench/backend run dev",
    "test:e2e": "pnpm --filter @workbench/e2e run test:e2e"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12"
    }
  }
}
